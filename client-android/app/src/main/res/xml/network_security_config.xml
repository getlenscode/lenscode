<?xml version="1.0" encoding="utf-8"?>
<!--
  Dev-only: allow cleartext WS to aura-bridge on the developer machine.
  android:usesCleartextTraffic in the manifest is not sufficient on newer API
  levels/some OkHttp paths without an explicit network security config
  permitting cleartext for the target host.

  10.0.2.2 is the Android emulator's host-loopback alias. 192.168.1.157 is
  the dev machine's LAN IP, for testing on a real device on the same
  network (see build.gradle.kts's bridgeUrl property) — update this if that
  IP changes, or widen to a whole /24 with a wildcard domain if it moves
  around a lot.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.157</domain>
    </domain-config>
</network-security-config>
