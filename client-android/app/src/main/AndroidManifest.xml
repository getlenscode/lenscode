<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice file search (spec §13, §63) — Android SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Follow Me: Config.DeviceTrackingMode.SPATIAL (ArDevice pose) requires
         this runtime permission on immersive devices — see
         developer.android.com/develop/xr/jetpack-xr-sdk/arcore/device-pose. -->
    <uses-permission android:name="android.permission.HEAD_TRACKING" />
    <!-- Home view weather HUD — coarse is enough for a current-conditions
         lookup, no need for GPS-grade precision. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- XR-only app: request the immersive feature. -->
    <uses-feature android:name="android.software.xr.immersive" android:required="true" />

    <!-- Android 11+ package visibility: without this, SpeechRecognizer.isRecognitionAvailable()
         can't see the on-device recognition service even when one exists. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Browser dock button — explicitly targeting Chrome needs visibility
             into that package even though we fall back to a package-less
             ACTION_VIEW (which needs no <queries> entry) if it's absent. -->
        <package android:name="com.android.chrome" />
    </queries>

    <!-- Cleartext allowances live in src/debug/ only — release builds must not
         carry usesCleartextTraffic or the dev network security config. -->
    <application
        android:label="LensCode"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LensCodeXr">

        <!-- The Jetpack XR ARCore library merges in com.google.ar.core.min_apk_version, and Play
             rejects the bundle unless the app also says whether ARCore is required. "optional":
             "required" would limit installs to Google's ARCore-supported device list (which may
             not include XR headsets) and force Google Play Services for AR. Head tracking runs on
             the headset's own XR runtime, so the app does not depend on it. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- Default to Home Space. Full space (needed to spatialize Subspace
             content) is opt-in: launch with the boolean intent extra fullSpace=true, see
             MainActivity. To make full space the default again, set this to
             XR_ACTIVITY_START_MODE_FULL_SPACE_MANAGED and flip EXTRA_FULL_SPACE. -->
        <property
            android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
            android:value="XR_ACTIVITY_START_MODE_HOME_SPACE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
