{
  "title": "XrServerMessage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "result": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "unauthorized",
                "pairing_required",
                "invalid_request",
                "not_found",
                "herdr_unavailable",
                "herdr_error",
                "conflict",
                "dangerous_op_unconfirmed",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "event"
        },
        "topic": {
          "type": "string",
          "enum": [
            "herdr",
            "git",
            "files",
            "machines",
            "connection"
          ]
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {},
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "topic",
        "event",
        "data",
        "seq"
      ],
      "additionalProperties": false
    }
  ]
}
